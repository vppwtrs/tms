# คัดลอกเป็น supabase/functions/.env สำหรับรัน Edge Function ในเครื่อง:
#   supabase functions serve --env-file supabase/functions/.env
#
# .env ห้าม commit — .gitignore ครอบ .env* อยู่แล้ว
#
# บน production ค่าพวกนี้ไม่ได้มาจากไฟล์ ตั้งด้วยคำสั่ง:
#   supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... R2_BUCKET=pod-photos
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY มีให้อัตโนมัติบน production)

SUPABASE_URL=https://ypkwavdtkhgvhuacwgla.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pod-photos
