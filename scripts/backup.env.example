# คัดลอกไฟล์นี้เป็น scripts/backup.env แล้วใส่ค่าจริง
# backup.env ห้าม commit — .gitignore ครอบ .env* อยู่แล้ว

SUPABASE_URL=https://ypkwavdtkhgvhuacwgla.supabase.co

# service_role key: Supabase dashboard > Project Settings > API
# คีย์นี้ข้าม RLS ทั้งหมด อ่านและเขียนได้ทุกตาราง เก็บไว้ในเครื่องเท่านั้น
# ห้ามเอาไปใส่ในเว็บ ใน repo หรือส่งในแชทเด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# โฟลเดอร์ปลายทาง — ให้ชี้เข้าไปในโฟลเดอร์ที่แอป Google Drive sync อยู่
# แล้ว Drive จะอัปขึ้นคลาวด์ให้เอง ไม่ต้องต่อ Google API
# ตัวอย่าง: G:\My Drive\TMS-POD  หรือ  C:\Users\Zenk\Google Drive\TMS-POD
BACKUP_DIR=
