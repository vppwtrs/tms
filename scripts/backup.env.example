# คัดลอกไฟล์นี้เป็น scripts/backup.env แล้วใส่ค่าจริง
# backup.env ห้าม commit — .gitignore ครอบ .env* อยู่แล้ว
#
# ใช้กับ 2 สคริปต์:
#   - scripts/migrate-pod-to-r2.mjs   (copy รูปเก่า Supabase Storage -> R2 ครั้งเดียว)
#   - scripts/backup-pod-photos.mjs   (สำเนาลงโฟลเดอร์ในเครื่อง อ่านต้นฉบับจาก R2)

SUPABASE_URL=https://ypkwavdtkhgvhuacwgla.supabase.co

# service_role key: Supabase dashboard > Project Settings > API
# คีย์นี้ข้าม RLS ทั้งหมด อ่านและเขียนได้ทุกตาราง เก็บไว้ในเครื่องเท่านั้น
# ห้ามเอาไปใส่ในเว็บ ใน repo หรือส่งในแชทเด็ดขาด
# migrate-pod-to-r2 ต้องใช้ตัวนี้อ่านไฟล์เก่าจากถัง Supabase — หลัง migrate เสร็จไม่ต้องใช้แล้ว
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 ---
# จาก R2 > Overview > Account Details และหน้า API token ที่เพิ่งสร้าง
# ทั้งสี่ค่านี้เป็นความลับระดับเดียวกับ service_role — เครื่องนี้เท่านั้น ห้าม commit

# Account ID (อยู่ใน endpoint URL: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=

# Access Key ID + Secret Access Key จากตอนสร้าง API token (โชว์ครั้งเดียว)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ชื่อ bucket
R2_BUCKET=pod-photos

# --- สำเนาลงเครื่อง (เฉพาะ backup-pod-photos.mjs) ---
# โฟลเดอร์ปลายทางในเครื่องออฟฟิศ เว้นว่างได้ถ้ายังไม่ตั้งงานสำรอง
BACKUP_DIR=
