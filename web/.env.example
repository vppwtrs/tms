# คัดลอกเป็น web/.env แล้วใส่ค่าจริงจาก Supabase dashboard (Project Settings > API)
# ไฟล์ .env ห้าม commit — ดู .gitignore

# Project URL เช่น https://ypkwavdtkhgvhuacwgla.supabase.co
VITE_SUPABASE_URL=

# anon / public key — ค่านี้เปิดเผยได้ มันถูกฝังใน bundle อยู่แล้ว
# ด่านกันข้อมูลจริงคือ RLS ไม่ใช่การซ่อน key ตัวนี้
VITE_SUPABASE_ANON_KEY=

# service_role key ห้ามอยู่ในไฟล์นี้หรือไฟล์ไหนก็ตามใน repo
# มันข้าม RLS ทั้งหมด ที่ของมันคือ Edge Function secret เท่านั้น
