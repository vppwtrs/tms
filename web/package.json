{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run src/a11y",
    "typecheck": "tsc --noEmit",
    "dev:cloud": "vite --mode cloud",
    "build:cloud": "tsc --noEmit && vite build --mode cloud"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
